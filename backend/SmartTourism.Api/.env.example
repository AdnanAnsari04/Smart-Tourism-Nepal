# Copy this file to .env (gitignored) for local docker-compose usage, or export
# these the same names as real environment variables in your hosting platform.
# NEVER commit a real .env file.

# --- Database ---
SQL_CONNECTION_STRING=Server=localhost,1433;Database=SmartTourismDb;User Id=sa;Password=Dev_Local_Only_2026!;TrustServerCertificate=True;MultipleActiveResultSets=true
SQL_SA_PASSWORD=Dev_Local_Only_2026!

# --- JWT ---
JWT_SECRET=replace_with_a_random_64_char_secret_before_deploying
JWT_ISSUER=SmartTourism.Api
JWT_AUDIENCE=SmartTourism.Client

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seed admin account ---
# If not set, the seeder generates a random password and logs it once on first run.
SEED_ADMIN_EMAIL=admin@yatra.com
SEED_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE

# --- Google Sign-In ---
# OAuth 2.0 Client ID from Google Cloud Console > APIs & Services > Credentials.
# This is the public Client ID only — never a client secret. Must match the
# VITE_GOOGLE_CLIENT_ID used by the frontend (same value, both places).
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

